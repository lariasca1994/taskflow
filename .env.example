# Copia este archivo como .env y completa los valores locales.
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=taskflow

# Secretos del servidor. Generar cada uno por separado con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# JWT_SECRET firma las sesiones.
# PASSWORD_PEPPER se mezcla con las contrasenas antes de hashearlas: si
# alguien roba un volcado de la base sin este valor, los hashes no le
# sirven ni para probar contrasenas comunes.
#
# Deben ser DISTINTOS entre si, y PASSWORD_PEPPER nunca debe cambiarse
# una vez haya cuentas creadas: invalidaria todas las contrasenas.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
PASSWORD_PEPPER=cambia-esto-por-otro-secreto-distinto-y-aleatorio

# Sesion: inactividad deslizante y duracion maxima absoluta
SESION_INACTIVIDAD_MIN=30
SESION_MAXIMA_HORAS=12

# Limites del modulo de analisis
ARCHIVO_MAX_MB=10
ARCHIVO_MAX_FILAS=500000
ARCHIVOS_POR_USUARIO=5
ARCHIVO_HORAS_VIDA=24

